sequenceDiagram
    autonumber
    actor A as Admin
    participant V as Trình duyệt
    participant S as Security
    participant C as AdminUserController
    participant U as UserServiceImpl
    participant R as UserRepository
    participant DB as SQL Server
    A->>V: 1. Chọn Sửa User
    V->>S: GET /admin/users/id/edit
    alt 2.1.1–2.1.2 Chưa đăng nhập, tài khoản hết hiệu lực hoặc thiếu quyền
        S-->>V: Redirect login/expired hoặc 403
    else Admin hợp lệ
        S->>C: edit(id, model, flash)
        C->>U: getForEdit(id)
        U->>R: findById(id)
        R->>DB: SELECT User
        DB-->>R: User hoặc không có
        R-->>U: Optional User
        alt 2.2.1–2.2.2 User không tồn tại
            U-->>C: UserNotFoundException
            C-->>V: Redirect /admin/users + Flash lỗi
        else User tồn tại
            U-->>C: UserUpdateDTO (name,email,phone,address,active)
            C-->>V: 2. admin/user-edit
            alt 3.1–3.2 Chọn Hủy
                A->>V: Chọn Hủy
                V->>V: GET /admin/users, không lưu
            else 3. Chọn Lưu
                A->>V: Chỉnh năm trường được phép, Lưu thay đổi
                V->>S: POST /admin/users/id/edit + CSRF
                alt 4.5.1–4.5.2 CSRF hoặc quyền gửi không hợp lệ
                    S-->>V: 403 hoặc yêu cầu đăng nhập theo loại lỗi, không gọi Controller
                else Được phép tiếp nhận biểu mẫu
                S->>C: update(id,dto,errors,actor,model,flash)
                C->>C: @Valid UserUpdateDTO
                alt 4.1.1–4.1.2 Dữ liệu sai
                    C-->>V: admin/user-edit, giữ dữ liệu, lỗi từng trường, bước 3
                else Dữ liệu hợp lệ
                    C->>U: update(id,dto,actor.id()) qua transaction proxy
                    U->>R: lockActiveAdmins()
                    R->>DB: SELECT Admin active với PESSIMISTIC_WRITE, ORDER BY id
                    DB-->>R: Danh sách Admin đã khóa
                    R-->>U: admins
                    U->>R: findForUpdate(id)
                    R->>DB: SELECT User với PESSIMISTIC_WRITE
                    DB-->>R: User hoặc không có
                    R-->>U: Optional User
                    alt 4.4.1–4.4.2 User đã bị xóa
                        U-->>C: UserNotFoundException, rollback
                        C-->>V: Redirect /admin/users + Flash không tìm thấy
                    else User còn tồn tại
                        opt dto.active=false
                            U->>U: guardDeactivation(user,actorId,admins.size())
                        end
                        alt 4.3.1–4.3.2 Tự khóa hoặc Admin active cuối cùng
                            U-->>C: IllegalArgumentException, rollback
                            C-->>V: admin/user-edit + lỗi chung, bước 3
                        else Được phép cập nhật trạng thái
                            U->>R: existsByEmailIgnoreCaseAndIdNot(normalizedEmail,id)
                            R->>DB: Kiểm tra email của User khác
                            DB-->>R: boolean
                            R-->>U: boolean
                            alt 4.2.1–4.2.2 Email trùng
                                U-->>C: IllegalArgumentException, rollback
                                C-->>V: admin/user-edit + lỗi email chung, bước 3
                            else Email chưa được dùng
                                U->>U: Gán fullName,email,phone,address,active
                                U->>R: saveAndFlush(user)
                                R->>DB: UPDATE users, kiểm tra unique
                                alt 4.2.1–4.2.2 DataIntegrityViolationException
                                    DB-->>U: Xung đột qua Repository
                                    U-->>C: DataIntegrityViolationException, rollback
                                    C-->>V: admin/user-edit + lỗi chung, bước 3
                                else Lưu thành công
                                    DB-->>R: Thành công
                                    R-->>U: User
                                    Note over U,DB: COMMIT trước khi trả về Controller
                                    U-->>C: Hoàn tất
                                    C-->>V: 4. Redirect /admin/users + Flash thành công
                                end
                            end
                        end
                    end
                end
            end
        end
                end
    end
