sequenceDiagram
    autonumber
    actor A as Người dùng
    participant V as Trình duyệt
    participant S as Spring Security
    participant C as AuthController
    participant U as ShopUserDetailsService
    participant R as UserRepository
    participant DB as SQL Server
    A->>V: 1. Mở Đăng nhập
    V->>C: GET /login
    C-->>V: 2. guest/login + biểu mẫu CSRF
    alt 3.1–3.2 Chọn Đăng ký
        A->>V: Chọn liên kết Đăng ký
        V->>V: Điều hướng GET /register
        Note over A,V: Chuyển sang uc006-auth-register
    else 3. Gửi thông tin đăng nhập
        A->>V: Nhập email, password, chọn Đăng nhập
        V->>S: POST /login (email, password, CSRF)
        alt 4.2.1–4.2.2 CSRF thiếu hoặc sai
            S-->>V: 403, cần mở lại form ở bước 1
        else CSRF hợp lệ
            S->>U: loadUserByUsername(email)
            U->>R: findByEmailIgnoreCase(email.trim().toLowerCase(...))
            R->>DB: SELECT User theo email
            DB-->>R: User hoặc không có
            R-->>U: Optional User
            alt 4.1.1 Không tìm thấy tài khoản
                U-->>S: UsernameNotFoundException
                S-->>V: 4.1.2 Redirect /login?error, nhập lại bước 3
            else Tìm thấy tài khoản
                U-->>S: ShopPrincipal (id, email, password, role, active)
                S->>S: Kiểm tra enabled và BCrypt password
                alt 4.1.1 Mật khẩu sai hoặc active=false
                    S-->>V: 4.1.2 Redirect /login?error, nhập lại bước 3
                else Thông tin hợp lệ
                    S->>S: Thiết lập Authentication trong SecurityContext
                    alt 4.1–4.2 ROLE_ADMIN
                        S-->>V: Redirect /admin/users
                    else 4. ROLE_CUSTOMER
                        S-->>V: Redirect /
                    end
                end
            end
        end
    end
