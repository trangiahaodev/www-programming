sequenceDiagram
    autonumber
    actor A as Khách
    participant V as Trình duyệt
    participant S as Security
    participant C as RegistrationController
    participant U as RegistrationServiceImpl
    participant R as UserRepository
    participant DB as SQL Server
    participant L as WelcomeMailListener
    participant M as WelcomeMailService
    participant SMTP as SMTP
    A->>V: 1. Chọn Đăng ký
    V->>C: GET /register
    C-->>V: 2. guest/register + UserRegisterDTO + CSRF
    alt 3.1–3.2 Đã có tài khoản
        A->>V: Chọn liên kết Đăng nhập
        V->>V: GET /login, không đăng ký
    else 3. Gửi biểu mẫu
        A->>V: Nhập fullName, email, password, confirmPassword
        V->>S: POST /register + CSRF
        alt 4.5.1–4.5.2 CSRF hoặc quyền gửi không hợp lệ
            S-->>V: 403 hoặc yêu cầu đăng nhập theo loại lỗi, không gọi Controller
        else Được phép tiếp nhận biểu mẫu
        S->>C: register(dto, errors, flash)
        C->>C: @Valid UserRegisterDTO, kiểm tra BindingResult
        alt 4.1.1–4.1.2 Dữ liệu sai hoặc password không khớp
            C->>C: setPassword(null), setConfirmPassword(null)
            C-->>V: guest/register với lỗi, quay lại bước 3
        else Dữ liệu hợp lệ
            C->>U: register(dto) qua transaction proxy
            U->>U: Chuẩn hóa email, trim họ tên
            U->>R: existsByEmailIgnoreCase(email)
            R->>DB: Kiểm tra email
            DB-->>R: Có / không
            R-->>U: boolean
            alt 4.2.1–4.2.2 Email đã được dùng
                U-->>C: IllegalArgumentException
                C->>C: rejectValue(email), xóa hai mật khẩu
                C-->>V: guest/register với lỗi email, trở lại bước 3
            else Email mới
                loop Đến khi mã chưa được dùng
                    U->>U: Sinh mã USR + 17 ký tự UUID
                    U->>R: existsByUserCode(code)
                    R-->>U: boolean
                end
                U->>U: encoder.encode(password), ROLE_CUSTOMER, active=true
                U->>R: saveAndFlush(user)
                R->>DB: INSERT users, kiểm tra unique
                alt 4.3.1–4.3.2 DataIntegrityViolationException
                    DB-->>U: Xung đột dữ liệu qua Repository
                    Note over U,DB: Rollback, không có AFTER_COMMIT, không gửi thư
                    U-->>C: DataIntegrityViolationException
                    C->>C: reject(registration.conflict), xóa hai mật khẩu
                    C-->>V: guest/register + lỗi, trở lại bước 3
                else Lưu thành công
                    DB-->>R: User đã lưu
                    R-->>U: User có id
                    U->>U: events.publishEvent(UserRegisteredEvent)
                    U->>DB: Transaction proxy hoàn tất COMMIT
                    Note over U,L: Chỉ sau COMMIT thành công mới gọi listener
                    U->>L: registered(event) qua AFTER_COMMIT
                    L->>M: send(event) qua @Async proxy
                    alt 4.4.1 Hàng đợi đầy
                        M-->>L: TaskRejectedException
                        L->>L: 4.4.2 Log queue full, tài khoản giữ nguyên
                    else Tác vụ được nhận
                        M-->>L: Trả ngay, không chờ SMTP
                    end
                    U-->>C: register(dto) hoàn tất
                    C-->>V: 4. Redirect /login + Flash đăng ký thành công
                    opt Tác vụ đã được nhận vào welcomeMailExecutor
                        Note over M,SMTP: Luồng nền độc lập, có thể chạy trước hoặc sau redirect
                        alt app.mail.enabled=false
                            M->>M: Log disabled, không gửi
                        else Gửi email được bật
                            M->>M: sender.getIfAvailable(), tạo SimpleMailMessage
                            M->>SMTP: client.send(message)
                            alt 4.4.1–4.4.2 SMTP/config lỗi
                                SMTP-->>M: Exception (hoặc lỗi cấu hình trước send)
                                M->>M: Log loại lỗi, không rollback tài khoản
                            else SMTP tiếp nhận
                                SMTP-->>M: Hoàn tất send
                                M->>M: Log gửi thành công
                            end
                        end
                    end
                end
            end
        end
        end
    end
